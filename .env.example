# Dock – Umgebungsvariablen
#
# Ohne diese Werte läuft Dock vollständig im lokalen Modus ("Auf diesem Gerät",
# IndexedDB). Alle persönlichen Funktionen sind dann nutzbar; geteilte
# Klasseninhalte zwischen echten Benutzerkonten sind es nicht.
#
# Für den geteilten Modus wird ein Supabase-Projekt benötigt:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur lokal für Migrationen verwenden. Niemals in den Client-Bundle aufnehmen,
# niemals committen.
SUPABASE_SERVICE_ROLE_KEY=

# Maximale Dateigroesse pro Upload in Megabyte.
NEXT_PUBLIC_MAX_UPLOAD_MB=10
